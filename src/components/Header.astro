---
import { kontakt } from '../content/kontakt';

const odkazy = [
  { href: '/', label: 'Úvod' },
  { href: '/o-mne', label: 'O mně' },
  { href: '/masaze', label: 'Masáže' },
  { href: '/cenik', label: 'Ceník' },
  { href: '/kontakt', label: 'Kontakt' },
];

const cesta = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${kontakt.znacka} – úvod`}>
      <b>{kontakt.znacka}</b><span>{kontakt.motto}</span>
    </a>
    <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav">
      <svg><use href="#i-menu" /></svg>Menu
    </button>
    <nav class="nav" id="nav" aria-label="Hlavní navigace">
      <ul>
        {odkazy.map((o) => (
          <li>
            <a href={o.href} aria-current={cesta === o.href ? 'page' : undefined}>{o.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
